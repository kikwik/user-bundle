<html>
    <head>
        <title>{% block title %}{% endblock %}</title>
    </head>
    <body>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div data-test="flash" class="{{ label }}">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>